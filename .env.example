ACTUAL_SERVER_URL=https://unique-cat.pikapod.net
ACTUAL_PASSWORD=your_password
ACTUAL_BUDGET_ID=your_budget_sync_id
ACTUAL_DATA_DIR=./actual-data
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
DRY_RUN=false

# Seasonal income hints for scripts/ideate-budget.mjs (MM-DD / month count)
PEAK_SEASON_START=01-01
PEAK_SEASON_END=04-15
OFF_SEASON_MONTHS=8
OFF_SEASON_MONTHLY_INCOME=   # your typical monthly income May-Dec

# scripts/ideate-budget.mjs: optional manual balances (runway uses CHASE_SAVINGS). If all are set with BALANCE_AS_OF_DATE, .env values are used instead of Actual API balances.
ACCOUNT_BALANCE_CHASE_COLLEGE=
ACCOUNT_BALANCE_CHASE_SAVINGS=
ACCOUNT_BALANCE_CHASE_FREEDOM=
BALANCE_AS_OF_DATE=

# Optional: default target month for scripts/apply-budget.mjs (YYYY-MM). CLI --month overrides this.
# BUDGET_TARGET_MONTH=

# After consolidate remap, allow deleting empty source categories (--delete in scripts/consolidate.mjs)
AUTO_DELETE_EMPTY_CATEGORIES=false

# Create categories in Actual when the model proposes a name not in your budget (default: true)
AUTO_CREATE_CATEGORIES=true

# Optional: put new categories in this group (otherwise first expense group for outflows, income group for inflows)
# ACTUAL_NEW_CATEGORY_GROUP_ID=
# ACTUAL_NEW_CATEGORY_GROUP_NAME=Flexible

# Two-pass / refine (optional)
# REFINE_FROM_CATEGORY_NAMES=General,Miscellaneous
# REFINE_MODE=true
# DOUBLE_RUN=true
